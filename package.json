{
  "name": "weave-openclaw",
  "version": "0.0.1",
  "description": "OpenClaw third-party plugin: emit agent diagnostic events to W&B Weave's Agents OTel endpoint via the Weave Node SDK (gen_ai.* attribute namespace).",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "engines": {
    "node": ">=22.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wandb/weave-openclaw.git"
  },
  "files": [
    "dist/",
    "openclaw.plugin.json",
    "README.md",
    "LICENSE"
  ],
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ],
    "compat": {
      "pluginApi": ">=2026.4.25"
    },
    "build": {
      "openclawVersion": "2026.4.25"
    },
    "release": {
      "publishToNpm": true
    }
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.1",
    "weave": "file:../weave/sdks/node"
  },
  "devDependencies": {
    "@opentelemetry/sdk-trace-base": "^1.26.0",
    "@types/node": "^22.10.0",
    "openclaw": ">=2026.4.25",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "scripts": {
    "build": "tsc -p .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "pnpm test && pnpm build"
  }
}
