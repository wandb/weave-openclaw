{
  "name": "@wandb/weave-openclaw",
  "version": "0.1.5",
  "description": "OpenClaw plugin that traces agent sessions to W&B Weave for observability and debugging.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "engines": {
    "node": ">=22.14.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wandb/weave-openclaw.git"
  },
  "files": [
    "dist/",
    "index.ts",
    "src/",
    "!src/**/*.test.ts",
    "!src/test/",
    "openclaw.plugin.json",
    "README.md",
    "LICENSE"
  ],
  "openclaw": {
    "extensions": [
      "./index.ts"
    ],
    "runtimeExtensions": [
      "./dist/index.js"
    ],
    "compat": {
      "pluginApi": ">=2026.4.25"
    },
    "build": {
      "openclawVersion": "2026.4.25"
    },
    "install": {
      "clawhubSpec": "clawhub:@wandb/weave-openclaw",
      "npmSpec": "weave-openclaw",
      "defaultChoice": "clawhub"
    },
    "release": {
      "publishToClawHub": true
    }
  },
  "dependencies": {
    "@coreweave/forge-sdk": "file:.context/coreweave-forge-sdk-0.1.0.tgz",
    "@opentelemetry/api": "^1.9.1",
    "netrc-parser": "^3.1.6"
  },
  "devDependencies": {
    "@opentelemetry/sdk-trace-base": "^2.11.0",
    "@types/node": "^22.10.0",
    "openclaw": ">=2026.6.5",
    "typescript": "^5.6.0",
    "vitest": "^3.2.6"
  },
  "scripts": {
    "build": "tsc -p .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "pnpm test && pnpm build"
  }
}
